{
  "manifest_version": 3,
  "name": "AdLens - Meta Ad Library Analyzer",
  "version": "1.0.0",
  "description": "Scan, analyze, save and export ads from Meta Ad Library. Competitor research, creative ideas, data analysis.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.facebook.com/ads/library/*"
  ],
  "action": {
    "default_title": "Toggle AdLens panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
